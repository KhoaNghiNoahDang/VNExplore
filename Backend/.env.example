SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<public anon key>
SUPABASE_SERVICE_ROLE_KEY=<secret, optional: enables the shared route cache>
ALLOWED_ORIGINS=http://localhost:5173,https://<your-app>.vercel.app

# Language model for /v1/understand (optional). Without a key the app keeps its rule-based parser.
# Up to 3 Gemini keys (Google AI Studio, ideally different accounts/projects): rotated, and a spare when one runs out.
LLM_PROVIDER=gemini
GEMINI_API_KEY=<secret, set in Render only>
GEMINI_API_KEY_2=<optional>
GEMINI_API_KEY_3=<optional>
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
# LLM_DAILY_LIMIT=60
