# Supabase (Vercel → Project → Settings → Environment Variables). Both values are public; RLS protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Supabase → Project Settings → API>
# "true" once Google sign-in is configured in Google Cloud and Supabase.
VITE_GOOGLE_AUTH=false
# Optional: a separate backend on Render. Empty = not used.
VITE_API_URL=

# Cloudflare Turnstile site key (public). Set it BEFORE turning on CAPTCHA in Supabase
# (Auth → Attack Protection): once on, every sign-in / sign-up / reset / guest sign-in needs a token.
VITE_TURNSTILE_SITE_KEY=
